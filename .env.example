SAMAL_HTTP_ADDR=:8080
# RelaxDev проставляет PORT=8080. Для веба: apps/web/.env.relaxdev.example

# Neon → Project → Connect → Connection string (DIRECT, без "-pooler")
# Example: postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
SAMAL_DATABASE_URL=

SAMAL_JWT_SECRET=dev-change-me-32-bytes-minimum-secret
SAMAL_OTP_DEV=true

SAMAL_S3_ENDPOINT=localhost:9000
SAMAL_S3_ACCESS_KEY=samal
SAMAL_S3_SECRET_KEY=samalsecret
SAMAL_S3_BUCKET=samal
SAMAL_S3_USE_SSL=false
SAMAL_S3_PUBLIC_URL=http://localhost:9000/samal

# LiveKit is optional in MVP. Empty = stub rooms (signaling only).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# SMS. Пусто / stub = SMS не уходит, код в логе и в ответе (dev_code).
# Реальная SMS на РФ и KG: sms.ru (один ключ) или smsc.ru (логин + пароль).
# sms.ru → кабинет https://sms.ru/?panel=api  → SMS_PROVIDER=smsru SMS_API_KEY=<api_id>
# smsc.ru → https://smsc.ru/api/  → SMS_PROVIDER=smsc SMS_LOGIN=... SMS_API_KEY=<пароль>
SMS_PROVIDER=stub
SMS_API_KEY=
SMS_LOGIN=
SMS_SENDER=TooApp
