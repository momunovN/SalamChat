SALAM_HTTP_ADDR=:8080
# RelaxDev проставляет PORT=8080. Для веба: apps/web/.env.relaxdev.example

# Neon → Project → Connect → Connection string (DIRECT, без "-pooler")
# Example: postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
SALAM_DATABASE_URL=
DATABASE_URL=

SALAM_JWT_SECRET=dev-change-me-32-bytes-minimum-secret
SALAM_OTP_DEV=true

SALAM_S3_ENDPOINT=localhost:9000
SALAM_S3_ACCESS_KEY=salam
SALAM_S3_SECRET_KEY=salamsecret
SALAM_S3_BUCKET=salam
SALAM_S3_USE_SSL=false
SALAM_S3_PUBLIC_URL=http://localhost:9000/salam

# LiveKit Cloud: https://cloud.livekit.io/ — URL вида wss://<project>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# RelaxDev → хранилище → API Доступ. Пусто = файлы на диске сервера.
STORAGE_API_KEY=

# Яндекс.Почта. SMTP_PASS — пароль приложения: https://id.yandex.ru/security/app-passwords
# SMTP_USER и адрес в SMTP_FROM — один и тот же ящик. Пустой пароль = код только в логе.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Salam <name@yandex.ru>

# TURN для мобильных операторов. Пусто: LiveKit Cloud отдаёт свой TURN вместе с подключением.
# Свой TURN_URL подменяет ICE LiveKit, поэтому указывайте turn: или turns:.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Web Push. Пусто: ключи выводятся из SALAM_JWT_SECRET и живут, пока секрет тот же.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://salam-chat.ru

# SMS. Пусто / stub = SMS не уходит, код в логе и в ответе (dev_code).
# Ключ из кабинета https://admin.p1sms.ru/ («Инструкция по API») включает отправку.
SMS_PROVIDER=stub
SMS_API_KEY=
# Пусто: общее имя VIRTA. Своё имя — только после модерации в кабинете.
SMS_SENDER=
