# Same names as the Go API. Root ../../.env is also loaded.

TOOAPP_DATABASE_URL=
DATABASE_URL=
TOOAPP_JWT_SECRET=dev-change-me-32-bytes-minimum-secret
TOOAPP_OTP_DEV=true
PORT=3000
TOOAPP_PUBLIC_URL=http://localhost:3000

# Яндекс.Почта. SMTP_PASS — пароль приложения, не пароль от входа в Яндекс.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Salam <name@yandex.ru>

# TURN. Пусто: релей берётся у LiveKit Cloud.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# SMS. Пусто = код не шлётся, только в логе и в ответе (dev_code).
# Ключ из кабинета https://admin.p1sms.ru/ («Инструкция по API») включает отправку.
SMS_PROVIDER=stub
SMS_API_KEY=
# Пусто: общее имя VIRTA. Своё имя — только после модерации в кабинете.
SMS_SENDER=
