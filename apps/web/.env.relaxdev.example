# Скопируйте эти ключи в RelaxDev → проект → Переменные.
# Значения секретов НЕ коммитить. Домен после деплоя: https://<имя>.relaxdev.ru

# RelaxDev сам ставит PORT=8080. Менять не нужно.
PORT=8080

# Публичный URL сайта (подставьте свой после первого деплоя)
SAMAL_PUBLIC_URL=https://tooapp.relaxdev.ru

# Prisma / Postgres.
# Вариант A: БД RelaxDev — платформа сама проставит DATABASE_URL.
# Вариант B: оставить Neon — вставьте connection string (direct, без -pooler).
DATABASE_URL=
SAMAL_DATABASE_URL=

# Обязательно смените в проде
SAMAL_JWT_SECRET=сгенерируйте-длинную-случайную-строку

# Прод: код не возвращать в JSON
SAMAL_OTP_DEV=false

# SMS. stub = без SMS, код только в логах (для теста).
# Боевая отправка: SMS_PROVIDER=smsru и SMS_API_KEY=api_id с sms.ru
SMS_PROVIDER=stub
SMS_API_KEY=
SMS_LOGIN=
SMS_SENDER=TooApp
