# Скопируйте эти ключи в RelaxDev → проект → Переменные.
# Значения секретов НЕ коммитить. Домен после деплоя: https://<имя>.relaxdev.ru

# RelaxDev сам ставит PORT=8080. Менять не нужно.
PORT=8080

# Публичный URL сайта (подставьте свой после первого деплоя)
SALAM_PUBLIC_URL=https://salam-chat.ru

# Prisma / Postgres.
# Вариант A: БД RelaxDev — платформа сама проставит DATABASE_URL.
# Вариант B: Neon — connection string (direct, без -pooler).
DATABASE_URL=
SALAM_DATABASE_URL=

# Обязательно смените в проде
SALAM_JWT_SECRET=сгенерируйте-длинную-случайную-строку

# Прод: код не возвращать в JSON
SALAM_OTP_DEV=false

# LiveKit Cloud (звонки). URL вида wss://<project>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# RelaxDev → хранилище проекта → вкладка API Доступ
STORAGE_API_KEY=

# Valkey. На RelaxDev подключите Redis в панели — REDIS_URL появится сам.
# Свой адрес: SALAM_VALKEY_URL=redis://127.0.0.1:6379
# REDIS_URL=

# Яндекс.Почта. Порт 465 и SMTP_SECURE=true. Пароль — из «Пароли приложений».
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Salam <name@yandex.ru>

# TURN. Пусто: релей берётся у LiveKit Cloud. Свой адрес подменяет ICE.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# SMS. Ключ из кабинета https://admin.p1sms.ru/ («Инструкция по API»).
# stub = без SMS, код только в логах (для теста).
SMS_PROVIDER=p1sms
SMS_API_KEY=
# Пусто: общее имя VIRTA. Своё имя — только после модерации в кабинете.
SMS_SENDER=
