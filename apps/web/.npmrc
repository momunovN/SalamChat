# RelaxDev builds sometimes fail on `npm install` with ECONNRESET from the registry.
# Retry each download longer instead of failing the whole deploy on one dropped connection.
fetch-retries=6
fetch-retry-factor=2
fetch-retry-mintimeout=15000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
maxsockets=8
audit=false
fund=false
