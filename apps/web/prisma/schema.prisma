generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone       String    @unique
  displayName String    @default("") @map("display_name")
  username    String?   @unique
  avatarUrl   String?   @map("avatar_url")
  bio         String    @default("")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz(6)

  devices       Device[]
  chatsCreated  Chat[]       @relation("ChatCreator")
  memberships   ChatMember[]
  messages      Message[]
  receipts      Receipt[]
  uploads       Upload[]
  callsStarted  Call[]       @relation("CallInitiator")
  callEvents    CallEvent[]

  @@map("users")
}

model Device {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  platform          String
  deviceName        String   @default("") @map("device_name")
  pushToken         String?  @map("push_token")
  refreshTokenHash  String   @map("refresh_token_hash")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt        DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "devices_user_id_idx")
  @@map("devices")
}

model OtpChallenge {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, createdAt(sort: Desc)], map: "otp_phone_created_idx")
  @@map("otp_challenges")
}

model Chat {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          String
  title         String?
  avatarUrl     String?  @map("avatar_url")
  createdBy     String?  @map("created_by") @db.Uuid
  peerKey       String?  @unique @map("peer_key")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  lastMessageId String?  @map("last_message_id") @db.Uuid

  creator     User?        @relation("ChatCreator", fields: [createdBy], references: [id])
  members     ChatMember[]
  messages    Message[]    @relation("ChatMessages")
  lastMessage Message?     @relation("ChatLastMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)
  calls       Call[]

  @@index([updatedAt(sort: Desc)], map: "chats_updated_at_idx")
  @@map("chats")
}

model ChatMember {
  chatId             String    @map("chat_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  role               String    @default("member")
  joinedAt           DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  mutedUntil         DateTime? @map("muted_until") @db.Timestamptz(6)
  lastReadAt         DateTime? @map("last_read_at") @db.Timestamptz(6)
  lastReadMessageId  String?   @map("last_read_message_id") @db.Uuid

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId], map: "chat_members_user_id_idx")
  @@map("chat_members")
}

model Message {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatId    String    @map("chat_id") @db.Uuid
  authorId  String?   @map("author_id") @db.Uuid
  type      String
  payload   Json      @default("{}")
  clientId  String    @unique(map: "messages_client_id_uidx") @map("client_id")
  replyToId String?   @map("reply_to_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  editedAt  DateTime? @map("edited_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  chat         Chat         @relation("ChatMessages", fields: [chatId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id])
  replyTo      Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReplies")
  lastForChats Chat[]       @relation("ChatLastMessage")
  attachments  Attachment[]
  receipts     Receipt[]

  @@index([chatId, createdAt(sort: Desc)], map: "messages_chat_created_idx")
  @@map("messages")
}

model Attachment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId  String   @map("message_id") @db.Uuid
  kind       String
  objectKey  String   @map("object_key")
  mime       String   @default("")
  sizeBytes  BigInt   @default(0) @map("size_bytes")
  width      Int?
  height     Int?
  durationMs Int?     @map("duration_ms")
  waveform   Json?
  filename   String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId], map: "attachments_message_id_idx")
  @@map("attachments")
}

model Receipt {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  status    String
  at        DateTime @default(now()) @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, status], map: "receipts_user_status_idx")
  @@map("receipts")
}

model Upload {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  objectKey   String    @unique @map("object_key")
  mime        String
  sizeBytes   BigInt    @map("size_bytes")
  kind        String
  status      String    @default("pending")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "uploads_user_id_idx")
  @@map("uploads")
}

model Call {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatId      String    @map("chat_id") @db.Uuid
  initiatorId String    @map("initiator_id") @db.Uuid
  kind        String
  status      String
  sfuRoom     String?   @map("sfu_room")
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  answeredAt  DateTime? @map("answered_at") @db.Timestamptz(6)
  endedAt     DateTime? @map("ended_at") @db.Timestamptz(6)

  chat      Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  initiator User        @relation("CallInitiator", fields: [initiatorId], references: [id])
  events    CallEvent[]

  @@index([chatId, startedAt(sort: Desc)], map: "calls_chat_started_idx")
  @@map("calls")
}

model CallEvent {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callId  String   @map("call_id") @db.Uuid
  userId  String?  @map("user_id") @db.Uuid
  event   String
  payload Json     @default("{}")
  at      DateTime @default(now()) @db.Timestamptz(6)

  call Call  @relation(fields: [callId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([callId, at], map: "call_events_call_id_idx")
  @@map("call_events")
}

model SchemaMigration {
  version    String   @id
  appliedAt  DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("schema_migrations")
}
